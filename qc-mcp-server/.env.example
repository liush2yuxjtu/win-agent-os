# SQL Server 连接（只读账号）
QC_MSSQL_HOST=127.0.0.1
QC_MSSQL_PORT=1433
QC_MSSQL_USER=readonly_user
QC_MSSQL_PASSWORD=replace_me
QC_MSSQL_ENCRYPT=false
QC_MSSQL_TRUST_SERVER_CERTIFICATE=true
QC_MSSQL_CONNECT_TIMEOUT_MS=10000
QC_MSSQL_REQUEST_TIMEOUT_MS=30000

# 可选：数据字典目录，默认 ./raw_files
# QC_RAW_FILES_DIR=/absolute/path/to/raw_files
