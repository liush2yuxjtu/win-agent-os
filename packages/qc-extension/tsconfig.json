{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["extension/**/*.ts"],
  // skill 脚本（scripts/*.ts）依赖外部项目 video-management-chat 的 src/db.js，
  // 在 extension 内无法解析，按 skill assets 原样拷贝、不参与声明编译。
  "exclude": ["extension/skills/**/scripts/**"]
}
