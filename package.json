{
  "name": "lattice-eve-dashboard",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "npm run surface:web",
    "dev:frontend": "npm run surface:web:dev:frontend",
    "build": "npm run surface:web:build",
    "start": "npm run surface:web:start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspaces --if-present",
    "agent:dev": "tsx scripts/eve-profile.mts dev",
    "agent:headless": "tsx scripts/eve-profile.mts invoke",
    "build:eve": "tsx scripts/eve-profile.mts build",
    "dev:eve": "tsx scripts/eve-profile.mts dev",
    "start:eve": "tsx scripts/eve-profile.mts start",
    "surface:web": "tsx scripts/sync-extensions.mts && npm run dev --workspace surfaces-web",
    "surface:web:dev:frontend": "npm run dev:frontend --workspace surfaces-web",
    "surface:web:build": "tsx scripts/sync-extensions.mts && npm run build --workspace surfaces-web",
    "surface:web:start": "tsx scripts/sync-extensions.mts && npm run start --workspace surfaces-web",
    "surface:web:typecheck": "npm run typecheck --workspace surfaces-web",
    "surface:standalone": "npm run dev --workspace @chat-surface-ui/standalone",
    "surface:standalone:build": "npm run build --workspace @chat-surface-ui/standalone",
    "skills:sync": "tsx scripts/sync-skills.mts",
    "skills:check": "tsx scripts/sync-skills.mts --check-only --check-tables",
    "evals:list": "tsx scripts/eve-profile.mts eval --list",
    "evals:run": "tsx scripts/eve-profile.mts eval",
    "extensions:sync": "tsx scripts/sync-extensions.mts",
    "dev:aro": "tsx scripts/eve-profile.mts aro dev",
    "start:aro": "tsx scripts/eve-profile.mts aro start",
    "build:aro": "tsx scripts/eve-profile.mts aro build",
    "eve": "tsx scripts/eve-profile.mts"
  },
  "dependencies": {
    "@agentor/chat-wecom": "^0.1.3",
    "@ai-sdk/devtools": "^1.0.12",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@chat-adapter/state-memory": "^4.38.0",
    "@chat-adapter/state-redis": "^4.38.0",
    "@json-render/core": "^0.20.0",
    "@json-render/mcp": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "@json-render/shadcn": "^0.20.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "0.4.3",
    "ai": "^7.0.58",
    "chat": "^4.38.0",
    "chat-adapter-wechat": "^0.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "^0.38.3",
    "gray-matter": "^4.0.3",
    "hyperformula": "^3.4.0",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.0-preview.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "shiki": "4.1.0",
    "socks-proxy-agent": "^10.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "ws": "^8.21.3",
    "wuying-agentbay-sdk": "^0.22.0",
    "xlsx": "^0.18.5",
    "zod": "4.4.3",
    "aro-extension": "workspace:*",
    "qc-extension": "workspace:*",
    "exa-extension": "workspace:*",
    "dashboard-extension": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "just-bash": "^3.3.0",
    "microsandbox": "^0.5.10",
    "puppeteer-core": "^25.8.0",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "ai": "^7.0.58"
  },
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/chat-surface-ui",
    "packages/dsh-shared",
    "packages/exa-extension",
    "packages/qc-extension",
    "packages/dashboard-extension",
    "surfaces/standalone",
    "surfaces/web",
    "packages/aro-extension"
  ]
}
