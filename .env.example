# ---- 技能注册表 Supabase 双向同步（--push / --pull）----
# 复制为 .env.local 并填入真实值（Supabase 控制台 Project Settings → API Keys）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ---- 前端独立模式（npm run dev:frontend，单独测试 Web 前端）----
# EVE_FRONTEND_ONLY=1
# EVE_AGENT_ORIGIN=http://127.0.0.1:2000

# ---- 微信 bot（iLink ACP，1:1 私聊，QR 扫码获取凭据：weixin-chat-adapter login --env）----
WEIXIN_ACCOUNT_ID=replace_me
WEIXIN_BOT_TOKEN=replace_me

# ---- 企业微信 bot（智能机器人 WebSocket 模式，管理后台应用管理→智能机器人）----
WECOM_BOT_WS_BOT_ID=replace_me
WECOM_BOT_WS_SECRET=replace_me

# ---- AgentBay 远程沙盒 provider（agentbay_run_code 工具）----
# 也可不设置环境变量，改用 ~/.config/agentbay/api_key 文件（npm run agentbay:login 写入）
# AgentBay API key（AgentBay 控制台 → 服务管理 生成）
AGENTBAY_API_KEY=replace_me
# 区域：cn-hangzhou / ap-southeast-1 / us-east-1
AGENTBAY_REGION_ID=cn-hangzhou

# ---- Semantica knowledge graph MCP sidecar ----
SEMANTICA_MCP_URL=http://127.0.0.1:7333/mcp
# 非 loopback 或启用服务端鉴权时设置同一个 token
# SEMANTICA_MCP_TOKEN=replace_me
# 服务端配置（建议在 semantica-mcp-server/.env 中设置绝对路径）
# SEMANTICA_RAW_FILES_DIR=/absolute/path/to/qc-mcp-server/raw_files
# SEMANTICA_STATE_DIR=/absolute/path/to/semantica-mcp-server/.state
# SEMANTICA_MCP_HOST=127.0.0.1
# SEMANTICA_MCP_PORT=7333
